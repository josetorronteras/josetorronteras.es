---
import "@styles/global.css";
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ScrollToTopButton from "@components/shared/buttons/ScrollToTopButton.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: Date;
}

const { title, description, image, articleDate } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <Head {title} {description} {image} {articleDate} />
  </head>
  <body class="body">
    <div class="content">
      <Header />
      <div class="grow flex flex-col w-full">
        <div class="grow flex flex-col">
          <slot />
        </div>
        <Footer />
      </div>
    </div>
    <ScrollToTopButton />
  </body>
</html>

<style>
  @reference "@styles/global.css";

  .body {
    @apply bg-background text-text relative min-h-screen;
  }
  .content {
    @apply relative z-10 flex min-h-screen flex-col items-center justify-center px-4;
  }
</style>
