---
import "@styles/global.css";
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ScrollToTopButton from "@components/shared/buttons/ScrollToTopButton.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: Date;
}

const { title, description, image, articleDate } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <Head {title} {description} {image} {articleDate} />
    <noscript>
      <style>
        .animate-fade-in {
          opacity: 1 !important;
        }
      </style>
    </noscript>
  </head>
  <body class="body">
    <div class="content animate-fade-in">
      <Header />
      <div class="grow flex flex-col w-full">
        <div class="grow flex flex-col">
          <slot />
        </div>
        <Footer />
      </div>
    </div>
    <ScrollToTopButton />
    <script is:inline>
      (function () {
        function markReady() {
          document.documentElement.classList.add("fonts-ready");
        }
        var fallback = setTimeout(markReady, 300);
        if (document.fonts && document.fonts.status === "loaded") {
          clearTimeout(fallback);
          markReady();
        } else if (document.fonts) {
          document.fonts.ready.then(function () {
            clearTimeout(fallback);
            markReady();
          });
        }
      })();
    </script>


  </body>
</html>

<style>
  @reference "@styles/global.css";

  .body {
    @apply bg-background text-text relative min-h-screen;
  }
  .content {
    @apply relative z-10 flex min-h-screen flex-col items-center justify-center px-4;
  }
</style>
