---
import SocialLinks from "@components/shared/SocialLinks.astro";
import Link from "@components/shared/Link.astro";
---

<footer>
  <p class="mt-4 text-sm text-gray-500">
    Follow me on <Link
      href="https://github.com/josetorronteras"
      label="GitHub"
    /> for updates and insights.
  </p>
  <SocialLinks class="mt-4 justify-center" />
</footer>

<style>
  @reference "@styles/global.css";

  footer {
    @apply flex flex-col items-center justify-center p-10 text-center;
  }
</style>
