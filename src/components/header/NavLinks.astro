---
import { Routes } from "@data/content/Routes";

const { activePath, class: className } = Astro.props;
---

<ul class={`${className} md:gap-6 gap-8 text-center`}>
  {
    Routes.map((route) => (
      <li>
        <a
          href={route.href}
          class={`nav-link ${activePath === route.href ? "nav-link-active" : "nav-link-inactive"}`}
        >
          {route.label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  @reference "@styles/global.css";

  .nav-link {
    @apply text-text transition-colors duration-200 hover:font-bold;
  }
  .nav-link-active {
    @apply decoration-primary font-bold underline decoration-2 underline-offset-8;
  }
  .nav-link-inactive {
    @apply font-medium;
  }
</style>
