---
import PostCard from "@components/post/PostCard.astro";

const { posts } = Astro.props;
---

<section class="mt-16">
  <header>
    <h2 class="heading-secondary">Latest Posts</h2>
  </header>
  <div class="posts-grid">
    {
      posts
        .slice(0, 5)
        .map((post, index) => (
          <PostCard
            post={post}
            class:list={[index === 0 ? "sm:col-span-2" : ""]}
          />
        ))
    }
  </div>
  {
    posts.length > 5 && (
      <div class="show-all-posts-container">
        <a href="/posts" class="btn-primary">
          See all posts
        </a>
      </div>
    )
  }
</section>

<style>
  @reference "@styles/global.css";

  .posts-grid {
    @apply mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3;
  }
  .show-all-posts-container {
    @apply mt-8 flex justify-center;
  }
</style>
