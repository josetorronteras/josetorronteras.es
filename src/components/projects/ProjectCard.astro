---
const { project, class: className } = Astro.props;
import { TechIcons } from "@/components/shared/icons/techs/TechIcons.ts";
---

<article class:list={[className]}>
  {
    project.techs && project.techs.length > 0 && (
      <div class="tech-icons">
        {project.techs.map((techImg) => {
          const TechIcon = TechIcons[techImg];
          return TechIcon ? <TechIcon /> : null;
        })}
      </div>
    )
  }
  <div class="content">
    <h2 class="title">
      <a href={`/projects/${project.slug}`}>
        {project.title}
      </a>
    </h2>
    <p class="description">{project.description}</p>
  </div>
</article>

<style>
  @reference "@/styles/global.css";

  article {
    @apply bg-background-alt flex h-full flex-col rounded-2xl p-4 transition duration-250 ease-in hover:scale-[1.03];
  }
  .tech-icons {
    @apply mb-2 flex grow gap-2 pb-2;
  }
  .content {
    @apply flex flex-grow flex-col place-content-center items-start;
  }
  .title {
    @apply text-text mb-1 text-left text-lg font-semibold;
  }
  .description {
    @apply text-text/80 text-left text-sm;
  }
</style>
