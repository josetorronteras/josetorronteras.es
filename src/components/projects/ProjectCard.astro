---
import { TechIcons } from "@icons/techs/TechIcons";

const { project, class: className } = Astro.props;
---

<article class:list={[className, "card-article"]}>
  {
    project.techs && project.techs.length > 0 && (
      <div class="tech-icons">
        {project.techs.map((techImg) => {
          const TechIcon = TechIcons[techImg];
          return (
            TechIcon && (
              <span aria-label={techImg}>
                <TechIcon />
              </span>
            )
          );
        })}
      </div>
    )
  }
  <div class="content">
    <h2 class="title">
      <a class="card-link" href={`/projects/${project.slug}`}>
        {project.title}
      </a>
    </h2>
    <p class="description">{project.description}</p>
  </div>
</article>

<style>
  @reference "@styles/global.css";

  .tech-icons {
    @apply mb-2 flex grow gap-2 pb-2;
  }
  .content {
    @apply flex flex-grow flex-col place-content-center items-start;
  }
  .title {
    @apply text-text mb-1 text-left text-lg font-semibold;
  }
  .description {
    @apply text-text/80 text-left text-sm;
  }
</style>
