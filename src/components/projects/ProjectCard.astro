---
import GithubIcon from "@components/shared/icons/social/GithubIcon.astro";
import { techIcons } from "@components/shared/icons/techs/TechIcons";
import type { Project } from "@data/types/Project";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const Icon = techIcons[project.icon];
---

<article class="card-article post-article">
  <div class="flex items-center justify-between">
    {Icon ? <Icon /> : null}
    <GithubIcon class="w-5 fill-slate-400" />
  </div>
  <a class="card-link title" href={`${project.githubUrl}`} target="_blank" data-ackee-project={project.title}>
    {project.title}
  </a>
  <p class="description">
    {project.description}
  </p>
  <div class="techs paragraph-content">
    <span>{project.techs}</span>
  </div>
</article>

<style>
  @reference "@/styles/global.css";

  .post-article {
    @apply border-border/30 space-y-4 rounded-lg border-2 p-6;
    &:hover {
      @apply border-primary shadow-lg;
    }
  }
  .title {
    @apply mb-2 text-left text-xl font-bold text-white capitalize sm:mt-2 sm:mb-4 sm:line-clamp-2 md:min-h-14;
  }
  .description {
    @apply line-clamp-5 text-left text-sm text-slate-400;
  }
  .techs {
    @apply line-clamp-1 text-left text-xs font-medium;
  }
</style>

<script>
  import { ackee, EVENTS } from "@lib/ackee";

  document.querySelectorAll<HTMLAnchorElement>("[data-ackee-project]").forEach((el) => {
    el.addEventListener("click", () => {
      ackee.action(EVENTS.PROJECT_CLICK, { key: el.dataset.ackeeProject! });
    });
  });
</script>
