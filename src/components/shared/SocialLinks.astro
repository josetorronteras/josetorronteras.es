---
import MailIcon from "@components/shared/icons/social/MailIcon.astro";
import GithubIcon from "@components/shared/icons/social/GithubIcon.astro";
import LinkedinIcon from "@components/shared/icons/social/LinkedinIcon.astro";

const { class: className = "" } = Astro.props;
---

<ul class={`${className} flex gap-4`}>
  <li>
    <a href="mailto:hello@josetorronteras.com" aria-label="Email" data-ackee-social="Email">
      <MailIcon />
    </a>
  </li>
  <li>
    <a href="https://github.com/josetorronteras" aria-label="Github" data-ackee-social="GitHub">
      <GithubIcon />
    </a>
  </li>
  <li>
    <a href="https://linkedin.com/in/josetorronteras" aria-label="LinkedIn" data-ackee-social="LinkedIn">
      <LinkedinIcon />
    </a>
  </li>
</ul>

<script>
  import { ackee, EVENTS } from "@lib/ackee";

  document.querySelectorAll<HTMLAnchorElement>("[data-ackee-social]").forEach((el) => {
    el.addEventListener("click", () => {
      ackee.action(EVENTS.SOCIAL_CLICK, { key: el.dataset.ackeeSocial! });
    });
  });
</script>
