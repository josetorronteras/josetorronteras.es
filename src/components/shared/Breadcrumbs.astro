---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const siteUrl = Astro.site?.toString() || "https://josetorronteras.es";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, siteUrl).toString() } : {}),
  })),
};
---

<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol class="breadcrumb-list">
    {
      items.map((item, index) => (
        <li class="breadcrumb-item">
          {index > 0 && (
            <span class="breadcrumb-sep" aria-hidden="true">
              /
            </span>
          )}
          {item.href ? (
            <a href={item.href} class="breadcrumb-link">
              {item.label}
            </a>
          ) : (
            <span class="breadcrumb-current" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(breadcrumbJsonLd)}
/>

<style>
  @reference "@styles/global.css";

  .breadcrumbs {
    @apply mb-10;
  }
  .breadcrumb-list {
    @apply m-0 flex list-none flex-wrap items-center gap-1 p-0 text-sm;
  }
  .breadcrumb-item {
    @apply flex items-center gap-1;
  }
  .breadcrumb-sep {
    @apply text-text/20;
  }
  .breadcrumb-link {
    @apply text-text/30 hover:text-primary no-underline transition-colors duration-200;
  }
  .breadcrumb-current {
    @apply text-text/60;
  }
</style>
