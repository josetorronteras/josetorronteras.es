---
interface TocItem {
  id: string;
  text: string;
  index: number;
}

interface Props {
  toc: TocItem[];
}

const { toc } = Astro.props;
---

<nav class="toc">
  <p class="toc-label">In this article</p>
  <ol class="toc-list">
    {
      toc.map((item) => (
        <li>
          <a href={`#${item.id}`} class="toc-link" data-toc-id={item.id}>
            <span class="toc-num">{String(item.index).padStart(2, "0")}</span>
            <span class="toc-text">{item.text}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>(
    ".toc-link[data-toc-id]",
  );
  if (links.length > 0) {
    const ids = Array.from(links).map((l) => l.dataset.tocId!);
    const headings = ids
      .map((id) => document.getElementById(id))
      .filter(Boolean) as HTMLElement[];

    let current = "";
    const setActive = (id: string) => {
      if (id === current) return;
      current = id;
      links.forEach((l) =>
        l.classList.toggle("is-active", l.dataset.tocId === id),
      );
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
            break;
          }
        }
      },
      { rootMargin: "-10% 0px -80% 0px" },
    );

    headings.forEach((h) => observer.observe(h));
  }
</script>

<style>
  @reference "@styles/global.css";

  .toc {
    @apply w-full;
  }
  .toc-label {
    @apply text-text/25 mb-4 text-[0.625rem] font-bold tracking-[0.22em] uppercase;
  }
  .toc-list {
    @apply m-0 list-none space-y-0.5 p-0;
  }
  .toc-link {
    @apply relative flex items-baseline gap-3 rounded-lg px-3 py-2 no-underline transition-all duration-150;
    @apply text-text/35;

    &::before {
      content: "";
      @apply bg-primary absolute top-1/2 left-0 h-4 w-0.5 -translate-y-1/2 rounded-full opacity-0 transition-all duration-150;
    }

    &:hover {
      @apply bg-text/4 text-text/70;
      .toc-num {
        @apply text-primary/60;
      }
    }

    &.is-active {
      @apply text-text/80;
      &::before {
        @apply opacity-100;
      }
      .toc-num {
        @apply text-primary;
      }
      .toc-text {
        @apply font-medium;
      }
    }
  }
  .toc-num {
    @apply text-primary/30 shrink-0 font-mono text-[0.625rem] font-bold tracking-wider tabular-nums transition-colors duration-150;
  }
  .toc-text {
    @apply text-[0.8125rem] leading-snug;
  }
</style>
