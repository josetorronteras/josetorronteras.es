---
import { Image } from "astro:assets";
const { post, class: className } = Astro.props;
---

<article class:list={[className]}>
  <Image
    inferSize
    src={post.image}
    alt={post.imageAlt}
    widths={[200, 400, 600, 1000, 1400]}
    sizes="100vw"
    loading="lazy"
  />
  <div class="content">
    <h2 class="title">
      <a class="link" href={`/posts/${post.slug}/`}>
        {post.title}
      </a>
    </h2>
    <p class="excerpt">{post.excerpt}</p>
  </div>
</article>

<style>
  @reference "@/styles/global.css";

  article {
    @apply bg-background-alt relative flex h-full flex-col rounded-2xl p-4 transition duration-250 ease-in;
    &:hover {
      @apply scale-103;
    }
  }
  img {
    @apply aspect-[16/9] w-full rounded-lg object-cover;
  }
  .content {
    @apply mt-4 flex flex-grow flex-col text-left;
  }
  .title {
    @apply text-text mt-1 text-left text-xl font-semibold;
  }
  .excerpt {
    @apply text-text/80 mt-2 text-base;
  }
  .link {
    @apply after:absolute after:inset-0;
  }
</style>
