---
import { Image } from "astro:assets";

const { post, class: className } = Astro.props;
---

<article class:list={[className, "card-article"]}>
  <Image
    inferSize
    src={post.image}
    alt={post.imageAlt}
    widths={[200, 400, 600, 1000, 1400]}
    sizes="100vw"
    loading="lazy"
  />
  <div class="content">
    <h2 class="title">
      <a class="card-link" href={`/posts/${post.slug}/`}>
        {post.title}
      </a>
    </h2>
    <p class="excerpt">{post.excerpt}</p>
  </div>
</article>

<style>
  @reference "@/styles/global.css";

  img {
    @apply aspect-[16/9] w-full rounded-lg object-cover;
  }
  .content {
    @apply mt-4 flex flex-grow flex-col text-left;
  }
  .title {
    @apply text-text mt-1 text-left text-xl font-semibold;
  }
  .excerpt {
    @apply text-text/80 mt-2 text-base;
  }
</style>
