---
import Layout from "@layouts/Layout.astro";
import TocList from "@components/post/TocList.astro";
import { getCollection } from "astro:content";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h, i) => ({ id: h.slug, text: h.text, index: i + 1 }));

const formattedDate = post.data.date.toLocaleDateString("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  title={post.data.title}
  description={post.data.excerpt}
  image={post.data.image}
  articleDate={post.data.date}
>
  <main class="container px-4 sm:px-6 lg:px-8 pt-4 sm:pt-8 md:pt-16">
    <div class="max-w-[1100px] mx-auto">
      <!-- Back link -->
      <a href="/posts" class="back-link">&larr; Blog</a>

      <!-- Hero -->
      <header class="hero">
        <div class="hero-meta">
          <time class="hero-date">{formattedDate}</time>
          {
            post.data.tags.length > 0 && (
              <div class="hero-tags">
                {post.data.tags.map((tag: string) => (
                  <a href={`/tags/${encodeURIComponent(tag.toLowerCase())}`} class="hero-tag">
                    {tag}
                  </a>
                ))}
              </div>
            )
          }
        </div>
        <h1 class="hero-title">{post.data.title}</h1>
        <p class="hero-excerpt">{post.data.excerpt}</p>
      </header>

      <!-- Content -->
      <div class="post-layout">
        {
          toc.length > 0 && (
            <nav class="toc-mobile">
              <TocList toc={toc} />
            </nav>
          )
        }
        <div class="post-columns">
          {
            toc.length > 0 && (
              <aside class="post-sidebar">
                <div class="toc-sticky">
                  <TocList toc={toc} />
                </div>
              </aside>
            )
          }
          <article class="prose">
            <Content />
          </article>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  @reference "@styles/global.css";

  .back-link {
    @apply text-text/30 hover:text-primary mb-10 inline-block text-sm no-underline transition-colors duration-200;
  }
  .hero {
    @apply mb-12 max-w-3xl sm:mb-16;
  }
  .hero-meta {
    @apply mb-5 flex flex-wrap items-center gap-3;
  }
  .hero-date {
    @apply text-text/30 text-xs font-medium tracking-wider uppercase;
  }
  .hero-tags {
    @apply flex flex-wrap gap-1.5;
  }
  .hero-tag {
    @apply bg-primary/10 text-primary hover:bg-primary/20 rounded-full px-2 py-0.5 text-[0.65rem] no-underline transition-colors duration-150;
  }
  .hero-title {
    @apply text-text mb-5 text-3xl leading-[1.1] font-extrabold tracking-tight sm:text-4xl lg:text-5xl;
  }
  .hero-excerpt {
    @apply text-text/50 text-lg leading-relaxed sm:text-xl;
  }

  /* Layout */
  .post-layout {
    @apply border-text/8 border-t pt-10;
  }
  .post-columns {
    @apply flex items-start gap-16;
  }
  .post-sidebar {
    @apply hidden w-[200px] shrink-0 lg:block xl:w-[220px];

    .toc-sticky {
      @apply sticky top-28;
    }
  }
  .toc-mobile {
    @apply border-text/8 mb-10 border-b pb-8 lg:hidden;
  }
  .toc-label {
    @apply text-text/25 mb-4 block text-[0.625rem] font-bold tracking-[0.22em] uppercase;
  }
  .toc-list {
    @apply m-0 list-none space-y-1 p-0;
  }
  .toc-link {
    @apply text-text/35 flex items-baseline gap-3 py-1.5 no-underline transition-colors duration-150;

    &:hover {
      @apply text-text;
      .toc-num {
        @apply text-primary;
      }
    }
  }
  .toc-num {
    @apply text-primary/40 shrink-0 font-mono text-[0.625rem] font-bold tracking-wider tabular-nums;
    transition: color 0.15s;
  }
  .toc-text {
    @apply text-[0.8125rem] leading-snug;
  }
  .prose {
    @apply text-text/80 min-w-0 flex-1 text-[1.0625rem] leading-[1.85] sm:text-[1.125rem];

    :global(h2) {
      @apply text-text mt-14 mb-5 scroll-mt-28 text-2xl font-bold sm:text-[1.75rem];
    }
    :global(h3) {
      @apply text-text mt-10 mb-3 scroll-mt-28 text-xl font-semibold;
    }
    :global(p) {
      @apply mb-5;
    }
    :global(a) {
      @apply text-primary decoration-primary/30 hover:decoration-primary underline underline-offset-4 transition-all duration-150;
    }
    :global(strong) {
      @apply text-text font-semibold;
    }
    :global(ul) {
      @apply mb-6 list-none space-y-2 pl-0;
    }
    :global(ul li) {
      @apply relative pl-6;
    }
    :global(ul li)::before {
      content: "\2192";
      @apply text-primary/50 absolute left-0 text-sm font-light;
      top: 0.15em;
    }
    :global(ol) {
      @apply text-text/75 mb-6 list-inside list-decimal space-y-2;
    }
    :global(blockquote) {
      @apply text-text/60 border-l-primary/60 my-10 border-l-[3px] pl-6 text-xl leading-relaxed font-light italic;
    }
    :global(code:not(pre code)) {
      @apply bg-text/8 text-text/90 rounded px-1.5 py-0.5 font-mono text-[0.85em] tracking-tight;
    }
    :global(pre) {
      @apply my-8 overflow-x-auto rounded-xl bg-[#0d0f14] p-5 text-[0.875rem] leading-relaxed text-[#cdd6f4];
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.06),
        0 8px 32px -4px rgba(0, 0, 0, 0.35);
    }
    :global(pre code) {
      @apply bg-transparent p-0 text-sm text-inherit;
    }
    :global(hr) {
      @apply bg-text/10 my-14 border-none;
      height: 1px;
    }
    :global(img) {
      @apply my-10 w-full rounded-xl;
      box-shadow: 0 2px 20px -2px rgba(0, 0, 0, 0.12);
    }
    :global(table) {
      @apply my-8 w-full border-collapse text-sm;
    }
    :global(th) {
      @apply border-text/15 text-text/40 border-b-2 pb-2 text-left text-[0.75rem] font-semibold tracking-wider uppercase;
    }
    :global(td) {
      @apply border-text/8 text-text/75 border-b py-2.5;
    }
  }
</style>
