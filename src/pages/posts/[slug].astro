---
import Layout from "@layouts/Layout.astro";
import PostToc from "@components/post/PostToc.astro";
import Breadcrumbs from "@components/shared/Breadcrumbs.astro";
import RelatedPosts from "@components/post/RelatedPosts.astro";
import CopyCodeButton from "@components/shared/buttons/CopyCodeButton.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { render } from "astro:content";
import { dateLong } from "@lib/date";

export async function getStaticPaths() {
  const entries = await getCollection("posts");
  const allPosts = entries
    .map((entry) => ({ ...entry.data, slug: entry.id }))
    .sort((a, b) => b.date.getTime() - a.date.getTime());

  return entries.map((post) => {
    const relatedPosts = allPosts
      .filter((p) => p.slug !== post.id)
      .map((p) => ({
        ...p,
        sharedTags: p.tags.filter((t) => post.data.tags.includes(t)).length,
      }))
      .filter((p) => p.sharedTags > 0)
      .sort(
        (a, b) =>
          b.sharedTags - a.sharedTags || b.date.getTime() - a.date.getTime(),
      )
      .slice(0, 3);

    return {
      params: { slug: post.id },
      props: { post, relatedPosts },
    };
  });
}

const { post, relatedPosts } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h, i) => ({ id: h.slug, text: h.text, index: i + 1 }));

const formattedDate = dateLong.format(post.data.date);
---

<Layout
  title={post.data.title}
  description={post.data.excerpt}
  image={post.data.image}
  articleDate={post.data.date}
>
  <main class="container px-4 sm:px-6 lg:px-8 pt-4 sm:pt-8 md:pt-16">
    <div class="max-w-[1100px] mx-auto">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "Blog", href: "/posts" },
          { label: post.data.title },
        ]}
      />

      <!-- Hero -->
      <header class="hero">
        <div class="hero-content">
          <div class="hero-text">
            <div class="hero-meta">
              <time class="hero-date">{formattedDate}</time>
              {
                post.data.tags.length > 0 && (
                  <div class="hero-tags">
                    {post.data.tags.map((tag: string) => (
                      <a
                        href={`/tags/${encodeURIComponent(tag.toLowerCase())}`}
                        class="hero-tag"
                      >
                        {tag}
                      </a>
                    ))}
                  </div>
                )
              }
            </div>
            <h1 class="hero-title">{post.data.title}</h1>
            <p class="hero-excerpt">{post.data.excerpt}</p>
          </div>
          <div class="hero-img-wrap">
            <Image
              inferSize
              src={post.data.image}
              alt={post.data.imageAlt}
              widths={[400, 800]}
              sizes="(max-width: 768px) 100vw, 420px"
              loading="eager"
              class="hero-img"
            />
          </div>
        </div>
      </header>

      <!-- Content -->
      <div class="post-layout">
        {
          toc.length > 0 && (
            <nav class="toc-mobile">
              <PostToc toc={toc} />
            </nav>
          )
        }
        <div class="post-columns">
          <article class="prose">
            <Content />
          </article>
          {
            toc.length > 0 && (
              <aside class="post-sidebar">
                <div class="toc-sticky">
                  <PostToc toc={toc} />
                </div>
              </aside>
            )
          }
        </div>
      </div>

      <RelatedPosts posts={relatedPosts} />
    </div>
  </main>
  <CopyCodeButton />
</Layout>

<style>
  @reference "@styles/global.css";

  .hero {
    @apply mb-12 sm:mb-16;
  }
  .hero-content {
    @apply flex flex-col-reverse gap-8 md:flex-row md:items-center md:gap-12;
  }
  .hero-text {
    @apply min-w-0 flex-1;
  }
  .hero-img-wrap {
    @apply w-full overflow-hidden rounded-2xl md:w-[420px] md:shrink-0;
    aspect-ratio: 4/3;
  }
  .hero-img {
    @apply h-full w-full object-cover;
  }
  .hero-meta {
    @apply mb-5 flex flex-wrap items-center gap-3;
  }
  .hero-date {
    @apply text-text/30 text-xs font-medium tracking-wider uppercase;
  }
  .hero-tags {
    @apply flex flex-wrap gap-1.5;
  }
  .hero-tag {
    @apply bg-primary/10 text-primary hover:bg-primary/20 rounded-full px-2 py-0.5 text-[0.65rem] no-underline transition-colors duration-150;
  }
  .hero-title {
    @apply text-text mb-5 text-3xl leading-[1.1] font-extrabold tracking-tight sm:text-4xl lg:text-5xl;
  }
  .hero-excerpt {
    @apply text-text/50 text-lg leading-relaxed sm:text-xl;
  }

  /* Layout */
  .post-layout {
    @apply border-text/8 border-t pt-10;
  }
  .post-columns {
    @apply flex gap-16;
  }
  .post-sidebar {
    @apply hidden w-[200px] shrink-0 lg:block xl:w-[220px];

    .toc-sticky {
      @apply sticky top-28;
    }
  }
  .toc-mobile {
    @apply border-text/8 mb-10 border-b pb-8 lg:hidden;
  }

  .prose {
    @apply text-text/80 min-w-0 flex-1 text-[1.0625rem] leading-[1.85] sm:text-[1.125rem];

    :global(h2) {
      @apply text-text mt-14 mb-5 scroll-mt-28 text-2xl font-bold sm:text-[1.75rem];
    }
    :global(h3) {
      @apply text-text mt-10 mb-3 scroll-mt-28 text-xl font-semibold;
    }
    :global(p) {
      @apply mb-5;
    }
    :global(a) {
      @apply text-primary decoration-primary/30 hover:decoration-primary underline underline-offset-4 transition-all duration-150;
    }
    :global(strong) {
      @apply text-text font-semibold;
    }
    :global(ul) {
      @apply mb-6 list-none space-y-2 pl-0;
    }
    :global(ul li) {
      @apply relative pl-6;
    }
    :global(ul li)::before {
      content: "\2192";
      @apply text-primary/50 absolute left-0 text-sm font-light;
      top: 0.15em;
    }
    :global(ol) {
      @apply text-text/75 mb-6 list-inside list-decimal space-y-2;
    }
    :global(blockquote) {
      @apply text-text/60 border-l-primary/60 my-10 border-l-[3px] pl-6 text-xl leading-relaxed font-light italic;
    }
    :global(code:not(pre code)) {
      @apply bg-text/8 text-text/90 rounded px-1.5 py-0.5 font-mono text-[0.85em] tracking-tight;
    }
    :global(pre) {
      @apply my-8 overflow-x-auto rounded-xl p-5 text-[0.875rem] leading-relaxed;
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.06),
        0 8px 32px -4px rgba(0, 0, 0, 0.35);
    }
    :global(pre code) {
      @apply bg-transparent p-0;
    }
    :global(hr) {
      @apply bg-text/10 my-14 border-none;
      height: 1px;
    }
    :global(img) {
      @apply my-10 w-full rounded-xl;
      box-shadow: 0 2px 20px -2px rgba(0, 0, 0, 0.12);
    }
    :global(table) {
      @apply my-8 w-full border-collapse text-sm;
    }
    :global(th) {
      @apply border-text/15 text-text/40 border-b-2 pb-2 text-left text-[0.75rem] font-semibold tracking-wider uppercase;
    }
    :global(td) {
      @apply border-text/8 text-text/75 border-b py-2.5;
    }
  }
</style>
