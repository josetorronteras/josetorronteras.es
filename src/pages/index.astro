---
import Layout from "@layouts/Layout.astro";
import PostsSection from "@components/PostsSection.astro";
import ProjectsSection from "@components/ProjectsSection.astro";
import { getCollection } from "astro:content";
import { projects } from "@data/content/Projects";

const entries = await getCollection("posts");
const posts = entries
  .map((entry) => ({ ...entry.data, slug: entry.id }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Layout>
  <main
    class="container px-4 sm:px-6 lg:px-8 pt-4 sm:pt-8 md:pt-16 pb-0 sm:pb-10 md:pb-20"
  >
    <div class="max-w-[1008px] mx-auto md:text-center">
      <h1 class="heading-primary">
        Crafting Pixel-Perfect iOS Apps with Code & Creativity
      </h1>
      <div class="content-description">
        <p>
          I'm an iOS developer who turns ideas into seamless, delightful apps
          using <span class="highlight-text">Swift</span>, <span
            class="highlight-text">SwiftUI</span
          >, and a pinch of magic. Explore my journey, tips, and tools for
          building apps that users love.
        </p>
      </div>
      {posts.length > 0 && <PostsSection posts={posts} />}
      {projects.length > 0 && <ProjectsSection projects={projects} />}
    </div>
  </main>
</Layout>

<style>
  @reference "@styles/global.css";

  .heading-primary {
    @apply text-text text-4xl leading-snug font-bold text-pretty sm:text-5xl lg:text-7xl;
  }
  .content-description {
    @apply text-text/80 mx-auto mt-8 max-w-[700px] text-lg leading-relaxed sm:text-xl;
  }
</style>
