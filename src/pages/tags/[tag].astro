---
import Layout from "@layouts/Layout.astro";
import Breadcrumbs from "@components/shared/Breadcrumbs.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("posts");
  const allTags = [...new Set(entries.flatMap((post) => post.data.tags || []))];

  return allTags.map((tag) => ({
    params: { tag: tag.toLowerCase() },
    props: {
      tag,
      posts: entries
        .filter((post) => post.data.tags?.includes(tag))
        .map((entry) => ({ ...entry.data, slug: entry.id }))
        .sort((a, b) => b.date.getTime() - a.date.getTime()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Layout title={`${tag}`} description={`Posts about ${tag}`}>
  <main class="container px-4 sm:px-6 lg:px-8 pt-4 sm:pt-8 md:pt-16">
    <div class="max-w-[1100px] mx-auto">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "Blog", href: "/posts" },
          { label: tag },
        ]}
      />

      <header class="header">
        <span class="eyebrow">Tag</span>
        <h1 class="title">{tag}</h1>
        <p class="count">
          {posts.length}
          {posts.length === 1 ? \"post\" : \"posts\"}
        </p>
      </header>

      <ul class="post-list">
        {
          posts.map((post) => (
            <li>
              <a href={`/posts/${post.slug}/`} class="post-row">
                <div class="post-row-img-wrap">
                  <Image
                    inferSize
                    src={post.image}
                    alt={post.imageAlt}
                    widths={[200, 400]}
                    sizes="180px"
                    loading="lazy"
                    class="post-row-img"
                  />
                </div>
                <div class="post-row-body">
                  <time class="post-date">
                    {post.date.toLocaleDateString("es-ES", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>
                  <h2 class="post-row-title">{post.title}</h2>
                  <p class="post-row-excerpt">{post.excerpt}</p>
                  <div class="post-tags">
                    {post.tags.map((t) => (
                      <span class:list={["post-tag", { active: t === tag }]}>
                        {t}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
</Layout>

<style>
  @reference "@styles/global.css";

  .header {
    @apply border-text/8 mb-12 border-b pb-8;
  }
  .eyebrow {
    @apply text-primary mb-2 block text-xs font-bold tracking-[0.2em] uppercase;
  }
  .title {
    @apply text-text mb-3 text-4xl font-bold tracking-tight sm:text-5xl;
  }
  .count {
    @apply text-text/40 text-sm font-medium;
  }
  .post-list {
    @apply m-0 list-none space-y-4 p-0;
  }
  .post-row {
    @apply flex gap-5 rounded-xl border border-transparent p-3 no-underline transition-all duration-200 sm:gap-6 sm:p-4;
    &:hover {
      @apply bg-background-alt border-border/20;
      .post-row-title {
        @apply text-primary;
      }
    }
  }
  .post-row-img-wrap {
    @apply w-24 shrink-0 overflow-hidden rounded-lg sm:w-36;
    aspect-ratio: 16/10;
  }
  .post-row-img {
    @apply h-full w-full object-cover;
  }
  .post-row-body {
    @apply flex min-w-0 flex-col gap-1.5 py-0.5;
  }
  .post-date {
    @apply text-text/30 text-xs font-medium tracking-wider uppercase;
  }
  .post-row-title {
    @apply text-text text-base leading-snug font-semibold transition-colors duration-200 sm:text-lg;
  }
  .post-row-excerpt {
    @apply text-text/40 line-clamp-2 hidden text-sm leading-relaxed sm:block;
  }
  .post-tags {
    @apply flex flex-wrap gap-1.5;
  }
  .post-tag {
    @apply bg-primary/8 text-primary/70 rounded-full px-2 py-0.5 text-[0.65rem];
    &.active {
      @apply bg-primary/20 text-primary;
    }
  }
</style>
