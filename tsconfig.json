{
  "extends": "astro/tsconfigs/base",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@styles/*": ["./src/styles/*"],
      "@icons/*": ["./src/components/shared/icons/*"],
      "@data/*": ["./src/data/*"],
      "@lib/*": ["./src/lib/*"]
    }
  }
}
